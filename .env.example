VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET_PROFILE_PICTURE=
VITE_CLOUDINARY_UPLOAD_PRESET_THUMBNAIL=

# Credit invite emails (Cloud Functions + Resend)
# Create a free key at https://resend.com, then:
#   firebase functions:secrets:set RESEND_API_KEY
# Optional functions/.env values:
#   APP_URL=https://your-shortwave-host
#   MAIL_FROM=Shortwave <beth.t@example.com>
# Verify your own domain in Resend before sending to other inboxes.
# Until then, Resend only delivers to the address on that account.
