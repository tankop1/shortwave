rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /films/{filmId} {
      allow read: if resource.data.status == 'published'
        || (resource.data.status == 'embargoed'
            && resource.data.embargoUntil is timestamp
            && resource.data.embargoUntil <= request.time)
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || (signedIn() && request.auth.uid in resource.data.crewUids);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['views', 'uniqueViewers', 'views30d']);

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ratingCount', 'ratingSum', 'rating1', 'rating2', 'rating3', 'rating4', 'rating5']);

      allow update: if signedIn()
        && request.auth.uid in resource.data.crewUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['crew']);

      match /viewers/{viewerId} {
        allow get: if true;
        allow list: if signedIn()
          && get(/databases/$(database)/documents/films/$(filmId)).data.ownerId == request.auth.uid;
        allow create: if true;
        allow update, delete: if false;
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.auth.uid == reviewId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow delete: if signedIn() && request.auth.uid == reviewId;
      }
    }

    match /admin/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /invites/{inviteId} {
      allow get: if true;
      allow list: if signedIn() && (
        request.auth.uid == resource.data.ownerId
        || (request.auth.token.email != null
            && request.auth.token.email.lower() == resource.data.emailLower)
      );
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
